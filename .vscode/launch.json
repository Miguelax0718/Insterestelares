{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "AstraMed Web (Puerto 8080 - Chrome)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": [
        "-d",
        "chrome",
        "--web-port=8080"
      ]
    },
    {
      "name": "AstraMed Web Server (Puerto 8080)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": [
        "-d",
        "web-server",
        "--web-port=8080"
      ]
    },
    {
      "name": "AstraMed Desktop (Windows)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": [
        "-d",
        "windows"
      ]
    }
  ]
}
