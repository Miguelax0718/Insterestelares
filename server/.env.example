# AstraMed agent gateway — copy to .env and fill in. Never commit real secrets.

# --- Server ---
PORT=8000
APP_VERSION=0.1.0

# --- Auth / access control ---
# Comma-separated client keys accepted in the X-AstraMed-Key header (soft gate).
APP_API_KEYS=change-me-1,change-me-2
# Dev only: disables X-AstraMed-Key checks (logs a warning).
AUTH_DISABLED=false
# Comma-separated CORS origins. Empty = no cross-origin access; "*" must be explicit.
ALLOWED_ORIGINS=http://localhost:8080
# Requests per minute per key/IP (0 disables).
RATE_LIMIT_PER_MIN=30

# --- Providers: agentrouter|fake / faster-whisper|fake / piper|fake ---
LLM_PROVIDER=agentrouter
STT_PROVIDER=faster-whisper
TTS_PROVIDER=kokoro

# --- LLM (AgentRouter, OpenAI-compatible) ---
AGENTROUTER_BASE_URL=https://agentrouter.org/v1
AGENTROUTER_API_KEY=
AGENTROUTER_MODEL=gpt-4o-mini
LLM_TIMEOUT_S=30

# --- STT (faster-whisper) ---
WHISPER_MODEL=base
WHISPER_COMPUTE_TYPE=int8
WHISPER_DEVICE=cpu
# WHISPER_DOWNLOAD_ROOT=/app/models

# --- TTS (Piper) ---
PIPER_VOICE=en_US-lessac-medium
PIPER_VOICES_DIR=/app/voices

# --- TTS (Kokoro-82M, default natural voice) ---
KOKORO_MODEL_PATH=models/kokoro/kokoro-v1.0.onnx
KOKORO_VOICES_PATH=models/kokoro/voices-v1.0.bin
KOKORO_VOICE=am_puck
KOKORO_SPEED=1.0
KOKORO_LANG=en-us
